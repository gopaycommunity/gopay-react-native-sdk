{
  "name": "@gopaycz/gopay-react-native-sdk",
  "version": "0.0.0",
  "description": "GoPay SDK for React Native (Expo module over the native iOS and Android SDKs)",
  "gopayNativeSdkVersion": "3.1.1",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "src",
    "!src/**/__tests__",
    "ios",
    "android/build.gradle",
    "android/src/main",
    "expo-module.config.json"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf build",
    "prepare": "husky && tsc",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p example",
    "test": "jest"
  },
  "keywords": [
    "react-native",
    "expo",
    "gopay",
    "payments"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gopaycommunity/gopay-react-native-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/gopaycommunity/gopay-react-native-sdk/issues"
  },
  "homepage": "https://github.com/gopaycommunity/gopay-react-native-sdk#readme",
  "author": "GoPay s.r.o.",
  "license": "MIT",
  "peerDependencies": {
    "expo": ">=57.0.0",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@react-native/jest-preset": "0.88.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.26",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^16.1.2",
    "expo": "~58.0.26",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.15",
    "prettier": "^3.0.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "parserPreset": {
      "parserOpts": {
        "issuePrefixes": [
          "GPMOB-"
        ]
      }
    },
    "rules": {
      "references-empty": [
        2,
        "never"
      ],
      "body-max-line-length": [
        0
      ]
    }
  }
}
